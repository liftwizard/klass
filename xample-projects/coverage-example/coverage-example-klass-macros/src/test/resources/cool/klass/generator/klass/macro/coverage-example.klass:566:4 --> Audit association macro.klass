package cool.klass.xample.coverage

association VersionedOwnedSourceHasCreatedBy
{
    versionedOwnedSourceCreatedBy: VersionedOwnedSource[0..*];
    createdBy: User[1..1] createdBy final;

    relationship this.createdById == User.userId
}

association VersionedOwnedSourceHasLastUpdatedBy
{
    versionedOwnedSourceLastUpdatedBy: VersionedOwnedSource[0..*];
    lastUpdatedBy: User[1..1] lastUpdatedBy;

    relationship this.lastUpdatedById == User.userId
}
