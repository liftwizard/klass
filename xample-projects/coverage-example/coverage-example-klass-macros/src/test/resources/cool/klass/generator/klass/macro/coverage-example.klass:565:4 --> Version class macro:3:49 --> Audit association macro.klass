package cool.klass.xample.coverage

association VersionedOwnedSourceVersionHasCreatedBy
{
    versionedOwnedSourceVersionCreatedBy: VersionedOwnedSourceVersion[0..*];
    createdBy: User[1..1] createdBy final;

    relationship this.createdById == User.userId
}

association VersionedOwnedSourceVersionHasLastUpdatedBy
{
    versionedOwnedSourceVersionLastUpdatedBy: VersionedOwnedSourceVersion[0..*];
    lastUpdatedBy: User[1..1] lastUpdatedBy;

    relationship this.lastUpdatedById == User.userId
}
