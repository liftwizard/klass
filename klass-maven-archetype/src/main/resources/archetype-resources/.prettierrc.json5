{
	// Number of spaces per indentation level
	// Default: 2
	tabWidth: 4,

	// Indent with tabs instead of spaces
	// Default: false
	useTabs: true,

	// Add semicolons at the end of statements
	// Default: true
	semi: true,

	// Use double quotes by leaving singleQuote disabled
	// Default: false
	singleQuote: false,

	// Print trailing commas wherever possible in multi-line comma-separated structures
	// Default: "es5"
	// Options: "none" | "es5" | "all"
	trailingComma: "all",

	// Print spaces between brackets in object literals
	// Default: true
	bracketSpacing: false,

	// Put opening braces on their own line
	// Default: "next-line" in prettier-next-line and prettier-java-next-line
	// Options: "next-line" | "same-line"
	braceStyle: "next-line",

	// Include parentheses around a sole arrow function parameter
	// Default: "always"
	// Options: "avoid" | "always"
	arrowParens: "always",

	// Line length where Prettier will try to wrap
	// Default: 80
	printWidth: 120,

	// prettier-plugin-java: Position of binary operators in wrapped lines
	// Default: "end"
	// Options: "start" | "end"
	experimentalOperatorPosition: "start",

	// prettier-java-next-line: Import groups in Spotless's importOrder format
	importOrder: "java,javax,,#java|#javax,#",

	overrides: [
		{
			files: [".yamllint.yaml", "**/*.yaml", "**/*.yml"],
			options: {
				tabWidth: 2,
				useTabs: false,
			},
		},
	],
}
