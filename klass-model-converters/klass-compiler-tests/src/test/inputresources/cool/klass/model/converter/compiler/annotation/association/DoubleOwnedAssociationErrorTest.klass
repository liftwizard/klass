package dummy

class ExampleClass1
{
    id: Long key;
}

class ExampleClass2
{
    id: Long key;
}

association DoubleOwnedAssociation
{
    source: ExampleClass1[1..1] owned;
    target: ExampleClass2[1..1] owned;

    relationship this.id == ExampleClass2.id
}

class ExampleClass3
{
    id: Long key;
}

class ExampleClass4
{
    id: Long key;
}

association DoubleOwnedAssociationWithoutRelationship
{
    source: ExampleClass3[1..1] owned;
    target: ExampleClass4[1..1] owned;
}
