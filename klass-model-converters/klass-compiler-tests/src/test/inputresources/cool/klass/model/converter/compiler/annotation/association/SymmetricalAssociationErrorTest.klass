package dummy

class DummyClass
{
    id: Long key;
}

association DummyAssociation
{
    source: DummyClass[1..1];
    target: DummyClass[1..1];

    relationship this.id == DummyClass.id
}

association DummyAssociationWithoutRelationship
{
    optionalSource: DummyClass[0..1];
    optionalTarget: DummyClass[0..1];
}
