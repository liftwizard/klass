package cool.klass.model.converter.compiler.annotation.association

class Question
{
    id: Long key;
}

class Answer
{
    id: Long key;
}

association QuestionHasAnswers
{
    question: Question[1..1];
    answers: Answer[0..*];
}

class QuestionDetail
{
    id: Long key;
}

association QuestionHasDetail
{
    question: Question[1..1];
    detail: QuestionDetail[1..1] owned;
}

class AnswerNote
{
    id: Long key;
}

association AnswerHasNote
{
    note: AnswerNote[0..1] owned;
    answer: Answer[0..1];
}

class QuestionSummary
{
    id: Long key;
    questionId: Long private;
}

association QuestionHasSummary
{
    question: Question[1..1];
    summary: QuestionSummary[1..1] owned;

    relationship this.id == QuestionSummary.questionId
}

class AnswerSummary
{
    id: Long key;
}

class AnswerReview
{
    id: Long key;
    answerSummaryId: Long private;
}

association AnswerReviewHasSummary
{
    review: AnswerReview[0..1];
    summary: AnswerSummary[1..1] owned;

    relationship this.answerSummaryId == AnswerSummary.id
}
